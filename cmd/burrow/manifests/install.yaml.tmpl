# Burrow control-plane install manifests, rendered by `burrow cluster install` (text/template).
# Bundles everything Burrow needs in the cluster: the namespace, a least-privilege
# ServiceAccount (manage Deployments, read Pods/logs), an in-cluster Postgres for
# control-plane state (ADR-0012), the secrets, and burrowd.
apiVersion: v1
kind: Namespace
metadata:
  name: {{.Namespace}}
  labels: { app.kubernetes.io/managed-by: burrow }
{{- if and (ne .AppNamespace "default") (ne .AppNamespace .Namespace) }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{.AppNamespace}}
  labels: { app.kubernetes.io/managed-by: burrow }
{{- end }}
{{- if and (ne .AddonNamespace .Namespace) (ne .AddonNamespace .AppNamespace) }}
---
# Add-ons (curated backing services like the logs store and their collectors) get their own
# namespace: kept out of the app namespace so they don't clutter user workloads, and out of
# the control-plane namespace so a log store's contents never share the credential blast
# radius (ADR-0025).
apiVersion: v1
kind: Namespace
metadata:
  name: {{.AddonNamespace}}
  labels: { app.kubernetes.io/managed-by: burrow }
{{- end }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: burrowd
  namespace: {{.Namespace}}
---
{{ template "appNamespaceRole" . }}
---
# The in-cluster build (ADR-0053, issue #278) runs each build as a Kubernetes Job in its own
# dedicated namespace — isolated from BOTH the app namespace (so build steps from the user's source
# cannot reach a running app's Secrets) and the control-plane namespace (so they cannot reach
# burrowd's ServiceAccount, credentials, or database). install provisions the namespace and burrowd's
# Role in it kubeconfig-side, because burrowd holds only namespaced Roles and cannot create namespaces
# or RBAC itself (least privilege) — the same reason `burrow env add` creates per-environment
# namespaces kubeconfig-side rather than burrowd creating them at runtime.
apiVersion: v1
kind: Namespace
metadata:
  name: {{.BuildNamespace}}
  labels: { app.kubernetes.io/managed-by: burrow }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: burrowd-builds
  namespace: {{.BuildNamespace}}
rules:
  # The build itself is a Job (a git-clone init container, then the buildah/buildpacks build container).
  # burrowd creates it, polls it to completion, and reaps it (deleting on a ttl and on idempotent re-run).
  # It also patches the Job's own metadata — the app, environment, and deploy reference the build is
  # FOR, plus a marker for one whose deploy a guardrail held. That metadata is what lets a build that
  # succeeds after its caller has disconnected still be finished rather than discarded (issue #504);
  # patch is scoped to this namespace and reaches only the build Jobs burrowd itself creates.
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["get", "list", "watch", "create", "patch", "delete"]
  # burrowd reads the build Job's pod for status and streams its logs back to the caller.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  # A private-source build (ADR-0057) needs a short-lived Secret in this namespace holding the provider
  # token for the git clone and the registry login; burrowd creates it owned by the Job so it is
  # garbage-collected when the Job is reaped. Scoped to this build namespace only.
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "create", "delete"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: burrowd-builds
  namespace: {{.BuildNamespace}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: burrowd-builds
subjects:
  - kind: ServiceAccount
    name: burrowd
    namespace: {{.Namespace}}
---
# Add-ons live in their own namespace (ADR-0025), so burrowd's permission to manage them is
# scoped there: a logs store is a Deployment + Service + PVC, its collector a DaemonSet +
# ConfigMap; the Postgres add-on (ADR-0031) adds a Secret per instance, named after it
# (burrow-postgres for the default environment, burrow-postgres-<env> for any other — ADR-0067 §1),
# holding that server's generated superuser password — burrowd creates it before the pod and reads it
# back to run admin SQL. The
# secrets grant is namespace-scoped to the add-on namespace ONLY (not name-scoped, not a
# ClusterRole): none of these grants reach the app or control-plane namespaces.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: burrowd-addons
  namespace: {{.AddonNamespace}}
rules:
  - apiGroups: ["apps"]
    resources: ["deployments", "daemonsets"]
    verbs: ["get", "list", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["services", "persistentvolumeclaims", "configmaps"]
    verbs: ["get", "list", "create", "update", "patch", "delete"]
  # A Postgres instance's superuser Secret lives in this namespace because a pod can only mount a
  # Secret in its own namespace (ADR-0031); there is one per instance, and therefore one per
  # environment (ADR-0067 §1). burrowd creates them, reads them to run admin SQL, and deletes them on
  # uninstall — the grant is namespace-scoped, so no per-environment RBAC change is needed. It also
  # covers the per-attachment Secret holding an app role's password, which CloudNativePG reads to
  # apply that password to the role (ADR-0066 §2): burrowd writes the credential and the operator
  # spends it, so no generated password ever reaches a statement burrowd issues.
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "create", "update", "delete"]
  # Postgres backup/restore run as short-lived Jobs in this namespace that pg_dump/pg_restore an
  # app's database to the backup PVC (ADR-0032). burrowd creates and reaps them and reads their
  # status; the Jobs read the superuser password from their instance's Secret via secretKeyRef.
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["get", "list", "create", "delete"]
  # ... and reads the backup Job's pod to recover the dump's byte size from the terminated
  # container's termination-message (ADR-0032). Read-only on pods, scoped to this namespace.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
  # The Postgres add-on IS a CloudNativePG `Cluster` and nothing else: burrowd
  # creates one `postgresql.cnpg.io/v1 Cluster` per environment in this namespace, reads its status
  # to answer "is this instance serving", and deletes it when the add-on is removed (ADR-0066 §1).
  # GET, CREATE, PATCH and DELETE, scoped to the add-on namespace, and no list: an instance is always
  # addressed by the name the registry holds, never discovered by sweeping the namespace. PATCH is for
  # ONE path, `spec.plugins`: an object-storage destination registered after the instance was created
  # is an ordinary sequence, and the alternative offered to that user would be destroying and
  # rebuilding the component holding every app's data (ADR-0066 §3). Nothing else about a Cluster
  # Burrow wrote is edited in place. DELETE is the whole of
  # what removal needs from this API: keeping the data (ADR-0064 §1) is done by detaching the
  # operator's claims first, which is a patch on persistentvolumeclaims and already granted above.
  # Installing the OPERATOR is not this grant and never will be: CRDs and cluster RBAC need
  # cluster-admin, which is why `burrow cluster postgres install` is an operator step run with a
  # kubeconfig.
  - apiGroups: ["postgresql.cnpg.io"]
    resources: ["clusters"]
    verbs: ["get", "create", "patch", "delete"]
  # An app's database and login role are a `Database` and a `DatabaseRole`, and CloudNativePG runs
  # the SQL for them on the instance it already manages (ADR-0066 §2). That is what replaces a
  # superuser connection on the attach path: burrowd writes an object and reads its status instead of
  # holding an admin DSN for every instance. GET, CREATE, UPDATE and DELETE, scoped to the add-on
  # namespace. UPDATE because an attach ADOPTS what is already there — an install that has been
  # attaching apps since before this existed keeps its databases, and the object is rewritten to
  # describe them. DELETE because a detach releases the description; it does NOT destroy the data,
  # which both objects carry a `retain` reclaim policy to guarantee (ADR-0064). No list: an
  # attachment is addressed by the name its instance and app give it, never discovered by sweeping.
  - apiGroups: ["postgresql.cnpg.io"]
    resources: ["databases", "databaseroles"]
    verbs: ["get", "create", "update", "delete"]
  # A physical backup is a `Backup` object and a schedule is a `ScheduledBackup`; burrowd creates them
  # and reads their status, and the operator does the work (ADR-0066 §2). GET and CREATE on backups:
  # one is created per physical backup and read until it settles, and none is ever deleted by burrowd
  # — each carries the `Cluster` as its owner, so Kubernetes collects them with the instance.
  # scheduledbackups adds DELETE, because the schedule is created with the instance and has to go with
  # it: a ScheduledBackup left behind fires at a Cluster that is not there. There is no list on either
  # — a backup is addressed by the name its id gives it, never discovered by sweeping the namespace.
  - apiGroups: ["postgresql.cnpg.io"]
    resources: ["backups"]
    verbs: ["get", "create"]
  - apiGroups: ["postgresql.cnpg.io"]
    resources: ["scheduledbackups"]
    verbs: ["get", "create", "delete"]
  # The pgBackRest plugin's `Stanza` describes WHERE one instance's repository is: the bucket, the
  # path, the retention window, and a reference to the two keys of the credential Secret above
  # (ADR-0066 §3). burrowd creates one per instance and deletes it with the instance. No update or
  # patch: a repository an instance was created against is not re-pointed under it, because the
  # backups already there would become unreachable from the stanza that wrote them.
  - apiGroups: ["pgbackrest.dalibo.com"]
    resources: ["stanzas"]
    verbs: ["get", "create", "delete"]
  # Read-only check that an add-on's pre-provisioned ServiceAccount exists before burrowd deploys
  # that add-on's workload (e.g. the metrics scraper's ServiceAccount, which the CLI applies
  # kubeconfig-side at install time). Get ONLY — no create/update/delete on serviceaccounts, so this
  # grants burrowd no RBAC-escalation power; it can verify the grant exists but never mint one.
  # Scoped to the add-on namespace.
  - apiGroups: [""]
    resources: ["serviceaccounts"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: burrowd-addons
  namespace: {{.AddonNamespace}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: burrowd-addons
subjects:
  - kind: ServiceAccount
    name: burrowd
    namespace: {{.Namespace}}
---
apiVersion: v1
kind: Secret
metadata:
  name: burrowd-api-token
  namespace: {{.Namespace}}
type: Opaque
stringData:
  token: "{{.Token}}"
---
apiVersion: v1
kind: Secret
metadata:
  name: burrowd-db
  namespace: {{.Namespace}}
type: Opaque
stringData:
  password: "{{.DBPassword}}"
  url: "postgres://burrow:{{.DBPassword}}@postgres:5432/burrow?sslmode=disable"
---
# This install's own id (ADR-0084 §5). A kube context name says how to REACH a cluster; it does not
# say which Burrow answered. Context names are user-controlled and reusable, and providers generate
# them deterministically — `doctl kubernetes cluster kubeconfig save` writes names like
# `do-nyc3-burrow`, so destroying a cluster and standing another one up yields a byte-identical
# context name for an entirely different cluster. The id is what a client compares against, so
# arriving at the wrong Burrow is a refusal that names the cause rather than a deploy landing
# somewhere nobody intended.
#
# A ConfigMap and NOT a Secret, deliberately: the id authorises nothing — it identifies an install,
# it does not open it — and a second person joining this install has to be able to read it. Putting a
# non-secret behind the RBAC that gates real credentials would make joining need permissions it has
# no reason to need.
#
# `burrow cluster upgrade` reads this back and re-renders the same value rather than minting a new one, the
# same treatment it gives the API token and the database password. A regenerated id would make every
# target already pointed here report a mismatch after a routine upgrade.
apiVersion: v1
kind: ConfigMap
metadata:
  name: burrow-install
  namespace: {{.Namespace}}
data:
  id: "{{.InstallID}}"
---
# The vendor-credential Secret (ADR-0023, ADR-0030): one opaque bag of provider tokens, one key
# per provider. Install creates it empty; `burrow provider add` sends the token over burrowd's
# authenticated control-plane API, which writes the key here through the scoped Role below.
apiVersion: v1
kind: Secret
metadata:
  name: burrow-credentials
  namespace: {{.Namespace}}
type: Opaque
---
# burrowd reads provider tokens from burrow-credentials at call time so a rotation needs no
# restart, and writes a token value it received over its authenticated control-plane API
# (ADR-0023, ADR-0030). This is its only access to a Secret's contents: get and update on exactly
# that one object in the control-plane namespace — not list, not watch, not create, and no other
# Secret.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: burrowd-credentials
  namespace: {{.Namespace}}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["burrow-credentials"]
    verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: burrowd-credentials
  namespace: {{.Namespace}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: burrowd-credentials
subjects:
  - kind: ServiceAccount
    name: burrowd
    namespace: {{.Namespace}}
---
# The scoped agent credential (ADR-0038): a ServiceAccount whose reachable capability is EXACTLY
# "the guardrailed control plane" and nothing else. `burrow cluster install` mints a long-lived token for
# it (the Secret below) and writes a self-contained, burrowd-only kubeconfig under ~/.burrow/; the
# agent — and any `kubectl` it shells out to — is confined to reaching burrowd by this Role. The
# human keeps their own admin kubeconfig for privileged and governance work. All users' agents
# share this one ServiceAccount for now; per-user ServiceAccounts are a deliberate, additive future
# step tied to SSO (ADR-0038 §5).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{.AgentServiceAccount}}
  namespace: {{.Namespace}}
---
# The agent's ENTIRE grant: proxy access to the burrowd Service (so the client reaches burrowd
# through the Kubernetes API-server proxy, ADR-0014) and `get` on the burrowd-api-token Secret so
# it can read the control-plane API token. Both are resourceNames-scoped to exactly those objects.
# There is nothing else: no pods, no other services, no other secrets, no list/watch, no other
# namespace, no cluster-scoped read — so the agent cannot go AROUND burrowd, rather than merely being
# asked not to by shell-denies (ADR-0021).
#
# That is one of the two things a binding guardrail needs, and this Role is only the first: it
# confines the agent to burrowd. What stops the agent relaxing a guardrail once it is there is that
# burrowd refuses a policy write, and an identity mint, from a credential of kind `agent` (ADR-0099).
# Neither half holds without the other — a wall the agent cannot walk around is worth nothing if it
# can move the wall.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{.AgentServiceAccount}}
  namespace: {{.Namespace}}
rules:
  - apiGroups: [""]
    resources: ["services/proxy"]
    resourceNames: ["burrowd", "burrowd:{{.Port}}", "http:burrowd:", "https:burrowd:"]
    verbs: ["get", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["burrowd-api-token"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{.AgentServiceAccount}}
  namespace: {{.Namespace}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{.AgentServiceAccount}}
subjects:
  - kind: ServiceAccount
    name: {{.AgentServiceAccount}}
    namespace: {{.Namespace}}
---
# A long-lived ServiceAccount token for the agent (ADR-0038 §3). The token controller populates
# .data.token and .data["ca.crt"] once this Secret exists; `burrow cluster install` polls for that and mints
# the scoped kubeconfig from it. A long-lived token is acceptable because the RBAC narrowness above
# is the real control and the token is revocable by deleting this Secret or the ServiceAccount; a
# bound short-lived token (TokenRequest) or a client certificate are noted future tightenings.
apiVersion: v1
kind: Secret
metadata:
  name: burrow-agent-token
  namespace: {{.Namespace}}
  annotations:
    kubernetes.io/service-account.name: {{.AgentServiceAccount}}
type: kubernetes.io/service-account-token
---
# The ONE cluster-scoped grant burrowd holds (ADR-0034). It is read-only — get/list only — on
# non-sensitive cluster-capability metadata: nodes (to infer the cloud provider and read each node's
# allocatable CPU/memory), pods (to sum resource requests across all namespaces for the scheduling
# headroom surface — issue #275), storageclasses (the default StorageClass), ingressclasses (which
# IngressClass names exist), and deployments (to confirm an ingress-nginx controller is actually
# running, not just that an orphan IngressClass lingers). This is what lets burrowd answer "what can
# this cluster do" and "is it at capacity" live, so the agent sees capabilities and headroom even
# after an out-of-band `kubectl apply`. Detecting cert-manager and other operators needs NO RBAC — it
# is done via API-group discovery. The cluster-wide pods read is get/list ONLY on pod metadata and
# their resource requests — no exec, no logs, no writes; pod logs stay the namespaced app grant. There
# is NOTHING else here: no secrets, no writes, no other verbs. burrowd's write surface stays exactly as
# namespaced as before; this is the only, measured, read-only exception to the otherwise-namespaced model.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: burrowd-cluster-capabilities
rules:
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list"]
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
  - apiGroups: ["storage.k8s.io"]
    resources: ["storageclasses"]
    verbs: ["get", "list"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["ingressclasses"]
    verbs: ["get", "list"]
  - apiGroups: ["apps"]
    resources: ["deployments"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: burrowd-cluster-capabilities
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: burrowd-cluster-capabilities
subjects:
  - kind: ServiceAccount
    name: burrowd
    namespace: {{.Namespace}}
---
{{if eq .Database "plain" -}}
# The control-plane database as a plain Deployment: the shape `--database plain` selects
# (ADR-0086 §2). It is chosen, never fallen back to, and what it costs is stated at install time
# rather than discovered later: one replica on one volume, with no backup, no point-in-time
# recovery, no failover and no standby. It exists for a cluster whose platform team will not accept
# the cluster-scoped CustomResourceDefinitions the CloudNativePG default needs.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: {{.Namespace}}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: {{.Namespace}}
spec:
  replicas: 1
  selector: { matchLabels: { app: postgres } }
  strategy: { type: Recreate }
  template:
    metadata: { labels: { app: postgres } }
    spec:
      containers:
        - name: postgres
          image: postgres:18
          # Lean server settings for a low-traffic control-plane state store (ADR-0012): the stock
          # defaults (128MB shared_buffers, 100 max_connections) are wildly generous here and leave
          # no headroom on a 1-2GB VPS. The official image's entrypoint forwards these -c args to
          # the postgres server. Keep these in step with LeanPostgresSettings in
          # controlplane/kube/addons.go, which tunes the Postgres add-on identically.
          args:
            - "-c"
            - "shared_buffers=64MB"
            - "-c"
            - "max_connections=30"
            - "-c"
            - "work_mem=4MB"
            - "-c"
            - "maintenance_work_mem=32MB"
            - "-c"
            - "effective_cache_size=256MB"
          env:
            - { name: POSTGRES_USER, value: burrow }
            - { name: POSTGRES_DB, value: burrow }
            - name: POSTGRES_PASSWORD
              valueFrom: { secretKeyRef: { name: burrowd-db, key: password } }
            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
          ports: [ { containerPort: 5432 } ]
          # Declared footprint: with the lean settings above, steady-state RSS is ~100-150MB. The
          # 320Mi limit leaves real headroom so normal/moderate load never OOMKills the database; a
          # small CPU request keeps it schedulable and there is no CPU limit (throttling a DB hurts).
          resources:
            requests: { cpu: 50m, memory: 96Mi }
            limits: { memory: 320Mi }
          readinessProbe:
            exec: { command: ["pg_isready", "-U", "burrow", "-d", "burrow"] }
            initialDelaySeconds: 5
            periodSeconds: 5
          volumeMounts:
            - { name: data, mountPath: /var/lib/postgresql/data }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: postgres-data }
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{.Namespace}}
spec:
  selector: { app: postgres }
  ports: [ { port: 5432, targetPort: 5432 } ]
{{- else -}}
# The control-plane database as a CloudNativePG `Cluster`, the default (ADR-0086 §1). It is the same
# stack every Postgres add-on instance runs on, so there is one set of failure modes to learn, one
# repair path, and one component that knows how to take a backup. `burrow cluster install` applies
# the CloudNativePG operator and waits for its controller before this object is written.
#
# The credential the owner role is created with. CloudNativePG's `bootstrap.initdb.secret` reference
# requires the `kubernetes.io/basic-auth` shape (a `username` and a `password`), which is why this
# is a second Secret rather than the `burrowd-db` one below: that one carries the connection URL
# burrowd reads, and a Secret's type cannot be changed after it is created.
apiVersion: v1
kind: Secret
metadata:
  name: burrowd-db-owner
  namespace: {{.Namespace}}
type: kubernetes.io/basic-auth
stringData:
  username: burrow
  password: "{{.DBPassword}}"
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: postgres
  namespace: {{.Namespace}}
spec:
  # One instance, matching what the plain Deployment ran. Under an operator this is a number rather
  # than a constant of the design: raising it is configuration, not a rewrite.
  instances: 1
  # The `postgres` superuser stays disabled (CloudNativePG's own default). burrowd connects as the
  # `burrow` owner role declared below, so there is no second credential in the cluster that nothing
  # uses and nothing rotates.
  enableSuperuserAccess: false
  storage:
    size: 1Gi
  # The same footprint the plain Deployment declares. The pod runs CloudNativePG's instance manager
  # as well as PostgreSQL — a few tens of megabytes — which the 320Mi limit absorbs because the lean
  # settings below keep PostgreSQL itself around 150MB.
  resources:
    requests: { cpu: 50m, memory: 96Mi }
    limits: { memory: 320Mi }
  postgresql:
    # The same lean tuning the plain Deployment takes as `-c` args, in the field CloudNativePG
    # reconciles them from. Keep these in step with LeanPostgresSettings in
    # controlplane/kube/addons.go, which tunes the Postgres add-on identically.
    parameters:
      shared_buffers: "64MB"
      max_connections: "30"
      work_mem: "4MB"
      maintenance_work_mem: "32MB"
      effective_cache_size: "256MB"
  bootstrap:
    initdb:
      # The database, the owner role, and the credential the URL below is built from — the same
      # names the plain Deployment's entrypoint creates from POSTGRES_DB/POSTGRES_USER, so what
      # burrowd connects to is identical either way.
      database: burrow
      owner: burrow
      secret:
        name: burrowd-db-owner
  managed:
    services:
      additional:
        # THE SERVICE NAME IS THE COMPATIBILITY SEAM. burrowd resolves `postgres:5432` from the URL
        # in the `burrowd-db` Secret, and CloudNativePG's own services are `postgres-rw`/`-ro`/`-r`,
        # so an additional managed service carries that name onto the primary. It is declared to the
        # operator rather than written beside the Cluster because the selector that finds the primary
        # is CloudNativePG's and changes between releases; asking for `rw` states the intent and lets
        # the controller spell it. It is also torn down with the Cluster rather than left behind.
        - selectorType: rw
          updateStrategy: patch
          serviceTemplate:
            metadata:
              name: postgres
            spec:
              ports:
                - name: postgres
                  port: 5432
                  targetPort: 5432
                  protocol: TCP
{{- end}}
---
# What burrowd may read about its own database, so `burrow cluster` can report which of the two
# shapes is running (ADR-0086 §2) instead of the answer living only in install output that has
# scrolled away. Get on exactly that one object: not list, not watch, and nothing that writes.
#
# It is rendered for BOTH shapes. A Role naming an API group the cluster does not serve is accepted
# and grants nothing, and rendering it unconditionally keeps a `plain` install one manifest away
# from the report rather than one manifest and an RBAC change.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: burrowd-controlplane-db
  namespace: {{.Namespace}}
rules:
  - apiGroups: ["postgresql.cnpg.io"]
    resources: ["clusters"]
    resourceNames: ["postgres"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: burrowd-controlplane-db
  namespace: {{.Namespace}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: burrowd-controlplane-db
subjects:
  - kind: ServiceAccount
    name: burrowd
    namespace: {{.Namespace}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: burrowd
  namespace: {{.Namespace}}
  labels: { app: burrowd }
spec:
  replicas: 1
  selector: { matchLabels: { app: burrowd } }
  template:
    metadata: { labels: { app: burrowd } }
    spec:
      serviceAccountName: burrowd
      containers:
        - name: burrowd
          image: {{.Image}}
          args: ["-listen=:{{.Port}}"]
          env:
            - { name: BURROW_NAMESPACE, value: {{.AppNamespace}} }
            - { name: BURROW_ADDON_NAMESPACE, value: {{.AddonNamespace}} }
            # POD_NAMESPACE is burrowd's own (control-plane) namespace, where it reads the
            # burrow-credentials Secret — distinct from BURROW_NAMESPACE, the app namespace.
            - name: POD_NAMESPACE
              valueFrom: { fieldRef: { fieldPath: metadata.namespace } }
            # This install's id (ADR-0084 §5), so burrowd can tell a caller that named a different
            # install that it has reached the wrong Burrow. It is read from the ConfigMap above
            # rather than restated here, so the value a client compares against and the value the
            # cluster records can never drift apart.
            #
            # optional: true because the design's answer to "this install has no id" is to serve
            # every caller, and a container that will not start cannot serve anybody. Without it, a
            # ConfigMap that was deleted, or not yet applied, wedges burrowd in
            # CreateContainerConfigError — turning a check that is meant to degrade into permissive
            # into a control plane that is down. The id is a refinement of an existing relationship;
            # it must never be a precondition for burrowd running at all.
            - name: BURROW_INSTALL_ID
              valueFrom: { configMapKeyRef: { name: burrow-install, key: id, optional: true } }
            - name: BURROW_API_TOKEN
              valueFrom: { secretKeyRef: { name: burrowd-api-token, key: token } }
            - name: BURROW_DATABASE_URL
              valueFrom: { secretKeyRef: { name: burrowd-db, key: url } }
          ports: [ { containerPort: {{.Port}} } ]
          # burrowd is a lean Go control-plane API server; a 192Mi limit is ample and a small CPU
          # request keeps it schedulable, with no CPU limit so request handling is not throttled.
          resources:
            requests: { cpu: 25m, memory: 64Mi }
            limits: { memory: 192Mi }
          readinessProbe:
            httpGet: { path: /healthz, port: {{.Port}} }
            initialDelaySeconds: 3
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: burrowd
  namespace: {{.Namespace}}
spec:
  selector: { app: burrowd }
  ports: [ { port: {{.Port}}, targetPort: {{.Port}} } ]
